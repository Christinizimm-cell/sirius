# Copie este arquivo para brain/config.env e preencha.
# NUNCA faça commit do config.env preenchido (ele está no .gitignore).

# Chave da API do Claude — está no documento da pasta "Chanel" do Desktop.
ANTHROPIC_API_KEY=

# Conexão SSH com o cachorro — está nas guias da pasta "SSH" do Desktop.
SIRIUS_HOST=
SIRIUS_SSH_USER=root

# Opcionais (têm padrão bom):
# SIRIUS_MODELO=claude-opus-5
# SIRIUS_MEMORIA=/opt/sirius-brain/memoria.json
