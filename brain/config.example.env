# Copie este arquivo para brain/config.env e preencha.
# NUNCA faça commit do config.env preenchido (ele está no .gitignore).

# Chave da API do Claude — está no documento da pasta "Chanel" do Desktop.
ANTHROPIC_API_KEY=

# BytePlus ModelArk (o serviço de modelo que o painel do robô usa).
# Chave: console.byteplus.com → ModelArk → API keys.
ARK_API_KEY=
# Endpoint de inferência (começa com ep-): ModelArk → Online inference.
# O endpoint "Conciencia" validado em 2026-09: ep-20260901203214-pbcr4
ARK_ENDPOINT_ID=ep-20260901203214-pbcr4
# Região Johor (Asia Pacific) — só mude se criar endpoint em outra região.
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Conexão SSH com o cachorro — está nas guias da pasta "SSH" do Desktop.
SIRIUS_HOST=
SIRIUS_SSH_USER=root

# Opcionais (têm padrão bom):
# SIRIUS_MODELO=claude-opus-5
# SIRIUS_MEMORIA=/opt/sirius-brain/memoria.json

# Serviços BytePlus já contratados (chaves na nota da Cristini — NUNCA
# commitar preenchido). Usados nas fases de voz e memória:
# BytePlus Voice (voice.ap-southeast-1.bytepluses.com): TTS seed-tts-2.0
# e ASR seedasr — a MESMA família do serviço de fala nativo do robô.
BYTEPLUS_VOICE_API_KEY=
# Voz usada pelo falar.py/conversar.py (padrão: a voz clonada da nota).
# VOZ_SPEAKER=S_h2kddmXc2
# VOZ_FORMATO=wav
# BYTEPLUS_ASR_APP_KEY=
# VikingDB (memória vetorial, coleção "Siriusmemory", índice "sirius"):
# VIKINGDB_AK=
# VIKINGDB_SK=
